RewriteEngine On

# Block access to .env file
<Files ".env">
    Order allow,deny
    Deny from all
</Files>

# Block access to db.php directly
<Files "db.php">
    Order allow,deny
    Deny from all
</Files>

# Route all API requests to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]
